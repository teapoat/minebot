# systemd unit template for the bot. See README.md for deployment steps.
# Adjust WorkingDirectory/ExecStart/User to wherever you install the bot.

[Unit]
Description=minebot (minebot.py, aiogram 3)
After=network.target

[Service]
WorkingDirectory=/opt/minebot
ExecStart=/opt/minebot/venv/bin/python minebot.py
Environment=PYTHONUNBUFFERED=1
Restart=always
RestartSec=5
TimeoutStopSec=10
User=minebot
Group=minebot
Type=simple

[Install]
WantedBy=multi-user.target
